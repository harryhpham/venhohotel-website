# Sao chép file này thành .env và điền thông tin thật
# KHÔNG commit file .env lên GitHub

# OpenAI API — lấy tại: platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Google Drive — tên root folder (mặc định: VenHoSocialManager)
DRIVE_ROOT_FOLDER=VenHoSocialManager

# Gmail SMTP — gửi email preview cho Harry
# Hướng dẫn lấy App Password: myaccount.google.com -> Security -> App passwords
GMAIL_SENDER=venhohotel@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

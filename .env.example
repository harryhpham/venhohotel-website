# OTA-01 agent integration (Mother Dashboard adapter — src/bff/ota/)
# Base URL of the independently-deployed venho-ota-agent service (see
# venho-ota-agent/docs/MOTHER_DASHBOARD_CONTRACT.md). Server-side only — never expose to the browser.
OTA_AGENT_BASE_URL=http://127.0.0.1:4801
OTA_AGENT_API_TOKEN=

# Luna Control Center BFF integration. Server-side only.
LUNA_API_BASE_URL=http://127.0.0.1:8001
LUNA_API_TOKEN=
LUNA_REQUEST_TIMEOUT_MS=60000

# Required to access /os and its internal API routes. Browser uses HTTP Basic Auth.
# Generate a long, unique password; do not commit the actual credentials.
VENHO_OS_USERNAME=admin
VENHO_OS_PASSWORD=
# Optional role for the authenticated operator: admin, operator, or viewer.
VENHO_OS_ROLE=admin

# Official Nous Research Hermes Agent integration. Server-side only.
# Defaults derive from $HOME/.hermes; set only when using a nonstandard location.
HERMES_NOUS_HOME=
HERMES_NOUS_REPO=
HERMES_NOUS_COMMAND=hermes
